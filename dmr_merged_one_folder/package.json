{
  "name": "dmr-poultries-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:dist": "electron-builder",
    "electron:dist:win": "electron-builder --win",
    "electron:dist:mac": "electron-builder --mac",
    "electron:dist:linux": "electron-builder --linux",
    "electron:dist:all": "electron-builder --mac --win --linux",
    "backend:install": "npm install --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:migrate": "npm run db:migrate --prefix backend",
    "backend:seed": "npm run db:seed --prefix backend",
    "test:mobile": "tsx --test src/shared/trip/tripCore.test.ts src/shared/trip/validation.deliveries.test.ts src/modules/supervisor-mobile/services/mobileTripState.test.ts src/modules/supervisor-mobile/services/mobileQueueDurability.test.ts src/modules/operations/vehicle-trips/services/tripHeaderApiService.step1.test.ts src/modules/operations/vehicle-trips/services/tripHeaderApiService.step2.test.ts src/modules/operations/vehicle-trips/services/tripHeaderApiService.step3.test.ts src/modules/operations/vehicle-trips/services/tripHeaderApiService.step4.test.ts src/modules/operations/vehicle-trips/services/tripHeaderApiService.step5.test.ts src/modules/operations/vehicle-trips/components/TripWizardStepper.test.ts src/modules/operations/vehicle-trips/components/Step_4/deliveryStep.test.ts",
    "test:fleet": "tsx --test src/modules/fleet-operations/activeFleetScope.test.ts src/modules/fleet-operations/services/fleetSessionCache.test.ts",
    "test:collections": "tsx --test src/modules/operations/collections/services/collectionService.contract.test.ts src/modules/operations/collections/services/collectionBalance.ui.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react-date-range": "^1.4.10",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "localforage": "^1.10.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-date-range": "^2.0.1",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "react-select": "^5.10.2",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0",
    "wait-on": "^7.2.0"
  },
  "main": "electron/main.cjs"
}
