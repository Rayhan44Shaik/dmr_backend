# DMR Poultries Backend — environment (local Phase 1)
#
# Path: DMR-Poultries-ERP/backend/.env
# Copy: cp backend/.env.example backend/.env

PORT=4000
NODE_ENV=development

# Local PostgreSQL (later swap to cloud connection string)
DATABASE_URL=postgresql://dmr:dmr_local_dev@localhost:5432/dmr_poultries

# CORS — Vite frontend (frontend/dmr-poultries-web) + preview + future mobile
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
