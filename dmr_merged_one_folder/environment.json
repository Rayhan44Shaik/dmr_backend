{
  "name": "DMR Poultries ERP",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "bash .cursor/ensure-postgres.sh && npm run backend:dev",
      "description": "Express + PostgreSQL API on http://localhost:4000 (health: /api/health)"
    },
    {
      "name": "frontend",
      "command": "npm run dev",
      "description": "Vite React dev server on http://localhost:5173"
    }
  ],
  "ports": [
    { "name": "frontend", "port": 5173 },
    { "name": "backend", "port": 4000 }
  ]
}
