{
  "appId": "com.electron.dmrpoultriesweb",
  "productName": "dmr-poultries-web",
  "directories": {
    "output": "electron-dist",
    "buildResources": "electron/resources"
  },
  "files": [
    "electron/**/*",
    "dist/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs",
    "type": "commonjs"
  },
  "mac": {
    "category": "public.app-category.utilities",
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64",
          "ia32"
        ]
      }
    ]
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility"
  }
}
