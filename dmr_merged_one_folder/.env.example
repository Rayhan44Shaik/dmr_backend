# Frontend (Vite) environment example
# Copy to .env.local if you need to override defaults.

# Backend API base URL (includes /api prefix)
VITE_API_BASE_URL=http://localhost:4000/api

# Optional request timeout in milliseconds
VITE_API_TIMEOUT_MS=30000

# Isolated Supervisor Mobile API namespace. Production should use either a
# same-origin HTTPS reverse proxy path (/api/mobile) or an approved absolute
# HTTPS endpoint. Never configure a phone with localhost.
VITE_MOBILE_API_BASE_URL=/api/mobile
VITE_MOBILE_API_TIMEOUT_MS=30000

# WhatsApp Backend Integration (set to "true" to enable WhatsApp API calls)
VITE_WHATSAPP_BACKEND_ENABLED=false
