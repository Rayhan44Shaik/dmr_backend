# DMR Poultries Backend — Local PostgreSQL
PORT=4000
NODE_ENV=development

# Local PostgreSQL (Phase 1 — later swap to cloud connection string)
# Database : dmr_poultries
# Host     : localhost
# Port     : 5432
# User     : dmr
DATABASE_URL=postgresql://dmr:dmr_local_dev@localhost:5432/dmr_poultries

# CORS — Electron/Vite frontend + future mobile
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Supervisor Mobile local login (created automatically on first /api/mobile/auth/login)
MOBILE_DEV_USERNAME=RuhullaShaik
MOBILE_DEV_PASSWORD=Supervisor@123

# Shop Delivery Email — backend-only SMTP (never put these in the frontend)
# Required: SMTP_HOST, SMTP_USER, SMTP_PASS
# SMTP_FROM defaults to SMTP_USER when empty. SMTP_PORT defaults to 587 (use 465 for implicit TLS).
# Leave credentials empty in local development to get a clean configuration error (emails will not send).
# Tests may set SMTP_HOST=json to use nodemailer's JSON transport (no real network).
# Never commit real passwords or app keys.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Shop Delivery WhatsApp — backend-only WhatsApp Business API (never put these in the frontend)
# Provider: "meta" for Meta Cloud API, or custom for other providers
# Required: WHATSAPP_PROVIDER, WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID
# Optional: WHATSAPP_TEMPLATE_NAME, WHATSAPP_TEMPLATE_LANGUAGE (required for business-initiated messages)
# WHATSAPP_API_VERSION defaults to v20.0 for Meta Cloud API
# WHATSAPP_API_BASE_URL for custom providers
# Leave credentials empty in local development to get a clean configuration error (WhatsApp will not send).
# Tests may use mock implementations.
# Never commit real tokens or secrets.
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en