# Dedicated disposable PostgreSQL only. The setup command refuses the protected
# dmr_poultries database and requires the database name to end in `_e2e`.
E2E_DATABASE_URL=postgresql://dmr:replace-locally@localhost:5432/dmr_poultries_e2e

# Account passwords are generated into ignored `.env.e2e.local` by setup.
# Never add real or E2E credentials to this example/source control.
